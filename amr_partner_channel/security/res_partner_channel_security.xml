<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rule untuk Portal User / Customer: Hanya bisa melihat dan edit kanal miliknya sendiri -->
        <record id="rule_partner_channel_portal" model="ir.rule">
            <field name="name">Portal User Channel Isolation</field>
            <field name="model_id" ref="model_res_partner_channel"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule untuk Internal Sales / Admin: Akses penuh -->
        <record id="rule_partner_channel_internal" model="ir.rule">
            <field name="name">Internal User Channel All Access</field>
            <field name="model_id" ref="model_res_partner_channel"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
